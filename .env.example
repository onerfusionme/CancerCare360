# Server
PORT=3001
APP_PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=debug

# Database
POSTGRES_DB=cancercare360
POSTGRES_USER=cancercare
POSTGRES_PASSWORD=cancercare123
DATABASE_URL=postgresql://cancercare:cancercare123@postgres:5432/cancercare360?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Elasticsearch
ELASTICSEARCH_URL=http://elasticsearch:9200

# MinIO Storage
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin123
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_DEFAULT_BUCKET=cancercare-documents

# Keycloak
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin123
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=cancercare
KEYCLOAK_CLIENT_ID=cancercare-backend
KEYCLOAK_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
FRONTEND_KEYCLOAK_CLIENT_ID=cancercare-frontend

# ClamAV
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Security
JWT_SECRET=super_secret_jwt_key_change_me_in_prod
SESSION_SECRET=super_secret_session_key_change_me_in_prod
ENCRYPTION_KEY=32_byte_hex_encryption_key_change_me

# External Services
AI_SERVICE_URL=http://ai-service:5000
EMAIL_PROVIDER_API_KEY=your_email_api_key
SMS_PROVIDER_API_KEY=your_sms_api_key

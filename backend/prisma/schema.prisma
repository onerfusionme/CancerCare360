model CareCircleProfile {
  id                   String             @id @default(uuid()) @db.Uuid
  tenantId             String             @db.Uuid
  userId               String?            @db.Uuid
  patientId            String?            @db.Uuid
  memberType           MemberType         @default(FAMILY_CAREGIVER)

  tenant         Tenant            @relation(fields: [tenantId], references: [id])
  requester      CareCircleProfile @relation("SentConnections", fields: [requesterId], references: [id])
  recipient      CareCircleProfile @relation("ReceivedConnections", fields: [recipientId], references: [id])
